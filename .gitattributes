# The OpenSCAD GUI rewrites files with CRLF on Windows. Normalize on commit so
# that does not show up as a whole-file diff.
*.scad text eol=lf
*.md   text eol=lf
*.png  binary

# Exported geometry. Marked explicitly so Git never applies text/EOL conversion
# to them on Windows, which would corrupt a binary STL.
*.stl  binary
*.3mf  binary
